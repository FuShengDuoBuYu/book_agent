AGENT_MONGODB_URI=mongodb+srv://username:password@example.mongodb.net/?appName=AutoBookKeeping
AGENT_MONGODB_DB=book_agent

BOOKKEEPING_API_BASE_URL=https://autobookkeeping-fastapi.onrender.com

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TEMPERATURE=0.2
PLANNER_TIMEOUT_SECONDS=20
PLANNER_NUM_PREDICT=512

LANGSMITH_TRACING=true
LANGSMITH_TRACING_V2=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=book-agent-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_CALLBACKS_BACKGROUND=true
