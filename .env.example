BOOKKEEPING_API_BASE_URL=https://autobookkeeping-fastapi.onrender.com
AGENT_MONGODB_URI=
AGENT_MONGODB_DB=book_agent
# Generate a dedicated random secret; keep stable across workers and restarts.
AGENT_MEMBER_KEY_SECRET=
# Set to the full 40-character Git SHA for immutable deployments.
AGENT_RELEASE_REVISION=

# Official API: LLM_PROVIDER=openai, LLM_BASE_URL=https://api.openai.com/v1,
# LLM_MODEL=gpt-6-luna; put LLM_API_KEY only in the private server environment.
# Native local: LLM_PROVIDER=ollama, LLM_BASE_URL=http://127.0.0.1:11434.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.fushengduobuyu.com/v1
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
LLM_REASONING_EFFORT=none
LLM_REASONING=false
LLM_INTENT_REASONING=false
LLM_PLANNING_REASONING=false
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=60s
# Optional GPU layer limit when sharing a GPU with other workloads:
# OLLAMA_NUM_GPU=24
LLM_TEMPERATURE=0.2
PLANNER_TIMEOUT_SECONDS=50
PLANNER_NUM_PREDICT=2048
REQUEST_TIMEOUT_SECONDS=120

LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
