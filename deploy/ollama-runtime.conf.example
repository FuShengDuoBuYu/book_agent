# After staging and contract/quality checks, install as a drop-in for the
# existing home Ollama service. Its host, model path and account stay configured
# by the original service. Stop the staging instance before switching.
[Service]
ExecStart=
ExecStart=/root/runtime/bin/ollama-v0.40.16/bin/ollama serve
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=60s
